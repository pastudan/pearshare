# PearShare local environment — copy to .env and fill in values.
# .env is gitignored and never committed.

# ── Deploy targets ────────────────────────────────────────────────────────────
# Space-separated list of targets. After each build the script automatically
# runs/deploys to every target — no flags needed.
#
#   local        → kill + relaunch PearShare on this machine
#   user@host    → rsync + relaunch on a remote Mac over Tailscale SSH
#
# Examples:
#   DEPLOY_HOSTS="local"
#   DEPLOY_HOSTS="local joycelin@macbook-air-1"
#   DEPLOY_HOSTS="dan@dans-macbook-air-blue joycelin@macbook-air-1"
DEPLOY_HOSTS="local"
